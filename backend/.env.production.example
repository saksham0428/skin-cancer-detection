# Render production environment variables
APP_ENV=production
DEBUG=False

# Replace with your deployed Vercel frontend URL. Do not add a trailing slash.
# Add additional Vercel domains separated by commas if needed.
ALLOWED_ORIGINS=https://your-project.vercel.app

# Path to the checkpoint available inside the Render container.
MODEL_TYPE=simple_cnn
MODEL_CHECKPOINT=models/skin_lesion_cnn_baseline.pth
MAX_UPLOAD_SIZE_MB=10
