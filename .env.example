# =============================================================================
# .env.example — Environment variable template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit a real .env file. The .env file is in .gitignore.
#
#   cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Environment: "development" or "production"
APP_ENV=development

# Enable debug logging (set to True only locally)
DEBUG=False

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------

# Model architecture: "resnet18" or "simple_cnn"
MODEL_TYPE=resnet18

# Path to the trained model checkpoint, relative to the project root.
# Default uses the ResNet18 checkpoint.
MODEL_CHECKPOINT=models/skin_lesion_resnet18.pth

# ---------------------------------------------------------------------------
# CORS — Allowed Origins
# ---------------------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call the API.
# For local development, include your React dev server:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# For production, set this to your actual frontend domain:
# ALLOWED_ORIGINS=https://your-frontend-domain.com

# ---------------------------------------------------------------------------
# File upload limits
# ---------------------------------------------------------------------------

# Maximum allowed file size in megabytes
MAX_UPLOAD_SIZE_MB=10
